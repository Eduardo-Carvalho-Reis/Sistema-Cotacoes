DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sistema_cotacoes?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3000
# WPPConnect Server endpoint; replace the session name with yours.
WHATSAPP_PROVIDER_URL=http://localhost:21465/api/minha-sessao/send-message
# Use the "full" token returned by /api/<sessao>/<SECRET_KEY>/generate-token.
WHATSAPP_PROVIDER_TOKEN=
# Optional per-user WPPConnect Server sessions. Keep the encryption key secret and stable.
WHATSAPP_SERVER_URL=http://localhost:21465
WHATSAPP_SERVER_SECRET_KEY=
WPP_TOKEN_ENCRYPTION_KEY=
